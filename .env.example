# =============================================================================
# Variables pour la Supabase CLI (liaison / déploiement) — MODÈLE
# Copier vers .env (ignoré par Git). Ne jamais committer de vraies valeurs.
# En CI, ces valeurs sont des GitHub Actions secrets.
# =============================================================================

# Jeton personnel : https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Référence du projet (Dashboard → Project Settings → General → Reference ID)
SUPABASE_PROJECT_ID=

# Mot de passe de la base (utilisé par `supabase db push`)
SUPABASE_DB_PASSWORD=
