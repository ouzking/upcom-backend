# =============================================================================
# Variables pour la Supabase CLI (liaison / déploiement) — MODÈLE
# Copier vers .env (ignoré par Git). Ne jamais committer de vraies valeurs.
# En CI, ces valeurs sont des GitHub Actions secrets.
# =============================================================================

# Jeton personnel : https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Référence du projet (Dashboard → Project Settings → General → Reference ID)
SUPABASE_PROJECT_ID=

# Mot de passe de la base (utilisé par `supabase db push`)
SUPABASE_DB_PASSWORD=

# --- Configuration de production (npm run prod:configure) --------------------
# URL publiques
SITE_PUBLIC_URL=https://www.upcomagency.com
ADMIN_URL=https://admin.upcomagency.com
# Origines supplémentaires autorisées (facultatif), ex. adresses *.netlify.app
EXTRA_ALLOWED_ORIGINS=https://upcomagencyservice.netlify.app,https://upcom-admin.netlify.app

# Envoi réel des e-mails (invitations, mot de passe oublié, alertes devis/messages)
# Clé Resend (https://resend.com) — domaine upcomagency.com vérifié dans Resend
RESEND_API_KEY=
EMAIL_FROM=UPCOM <no-reply@upcomagency.com>
# Destinataires des alertes (adresses fournies par UPCOM, séparées par des virgules)
NOTIFICATION_EMAIL_TO=
