# =============================================================================
# Secrets des Edge Functions — MODÈLE
# -----------------------------------------------------------------------------
# Local  : copier vers supabase/functions/.env (ignoré par Git), puis
#          npm run functions:serve
# Prod   : supabase secrets set --env-file supabase/functions/.env.production
#          (ou Dashboard → Edge Functions → Secrets)
#
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement par la plateforme : NE PAS les définir ici.
# =============================================================================

# Origines autorisées (CORS), séparées par des virgules : site public + back-office.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Sel du hachage des IP (rate-limit). Chaîne aléatoire longue : openssl rand -hex 32
IP_HASH_SALT=change-me-with-a-long-random-string

# Secret partagé des appels serveur → send-*-notification (en-tête x-webhook-secret).
# openssl rand -hex 32
NOTIFICATION_WEBHOOK_SECRET=change-me-with-another-long-random-string

# Envoi d'e-mails via Resend (https://resend.com). Vide = envoi désactivé (dev).
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. "UPCOM <notifications@votre-domaine>"
EMAIL_FROM=

# Destinataires des notifications (liste séparée par des virgules).
NOTIFICATION_EMAIL_TO=
# Optionnel : destinataires spécifiques (sinon NOTIFICATION_EMAIL_TO).
QUOTE_NOTIFICATION_EMAIL_TO=
CONTACT_NOTIFICATION_EMAIL_TO=

# URL du back-office (lien dans les e-mails de notification).
ADMIN_APP_URL=http://localhost:5174
# URL de redirection des invitations (page d'acceptation dans upcom-admin).
ADMIN_INVITE_REDIRECT_URL=http://localhost:5174/auth/accept-invite

# Cloudflare Turnstile (anti-bot). Vide = désactivé. En production : recommandé.
TURNSTILE_SECRET_KEY=
